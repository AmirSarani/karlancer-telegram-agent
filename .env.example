# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Karlancer HTTP (from browser localStorage auth-token.access_token — never commit)
KARLANCER_ACCESS_TOKEN=
# KARLANCER_COOKIE=
KARLANCER_BASE_URL=https://www.karlancer.com
KARLANCER_TIMEOUT_MS=30000

# OpenAI-compatible (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Persistence
DB_PATH=./data/agent.sqlite
MEMORY_DIR=./data/memory
STATE_DIR=./state

# MCP HTTP
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
MCP_API_KEY=
# MCP_ALLOW_ANON=false

ENABLE_TELEGRAM=true
ENABLE_WORKER=true
DAILY_TOKEN_LIMIT=200000
