# Telegram (optional when ENABLE_TELEGRAM=false)
TELEGRAM_BOT_TOKEN=
# One chat id, or comma-separated owner allowlist (first id receives outbound notifies)
TELEGRAM_OWNER_CHAT_ID=
# AES-256-GCM key for ephemeral re-login secrets (openssl rand -hex 32)
# TELEGRAM_SECRETS_KEY=

# Karlancer HTTP (from browser localStorage auth-token.access_token — never commit / never paste in chat)
KARLANCER_ACCESS_TOKEN=
# KARLANCER_COOKIE=
KARLANCER_BASE_URL=https://www.karlancer.com
KARLANCER_TIMEOUT_MS=30000

# OpenAI-compatible (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_LARGE_MODEL=gpt-4o

# Persistence
DB_PATH=./data/agent.sqlite
MEMORY_DIR=./data/memory
STATE_DIR=./state

# MCP HTTP
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
MCP_API_KEY=
MCP_API_SCOPES=read,write,approve,admin
# MCP_ALLOW_ANON=false
# MCP_CORS_ORIGIN=https://chat.openai.com
MCP_MAX_BODY_BYTES=256000

ENABLE_TELEGRAM=true
ENABLE_WORKER=true
DAILY_TOKEN_LIMIT=200000

# MCP HTTP session lifecycle
# MCP_SESSION_TTL_MS=1800000
# MCP_SESSION_CLEANUP_INTERVAL_MS=60000
# MCP_MAX_SESSIONS=100

# Karlancer credentials: default is SHARED process env (KARLANCER_ACCESS_TOKEN).
# Optional per-tenant encrypted-at-rest (see docs/OPERATIONS.md):
# KARLANCER_CREDENTIAL_KEK=   # 32-byte key, base64
# KARLANCER_CREDENTIAL_SECRET=  # alternative: scrypt-derived KEK

# Live auto-bid to Karlancer (default false on VPS — keep false unless you intentionally enable)
ALLOW_LIVE_AUTO_BID=false

# Optional Bale parallel notify (Telegram-compatible API). Leave empty to stub/skip.
# BALE_BOT_TOKEN=
# BALE_OWNER_CHAT_IDS=
# BALE_API_ROOT=https://tapi.bale.ai
