# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Your Telegram chat id (numeric). Message the bot once, then set this and restart.
TELEGRAM_OWNER_CHAT_ID=

# OpenAI-compatible API (e.g. GapGPT, OpenAI, local proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Playwright: path to saved browser storage state (login cookies for karlancer.com)
KARLANCER_STORAGE_STATE_PATH=./storage/karlancer-storage-state.json

# Optional
# HEADLESS=true
# MEMORY_DIR=./data/memory
